generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  major        String?
  year         String?
  bio          String?
  avatar       String?
  banners String[]
  borderColor  String?
  vibeTemplate String?
  vibeFill     String?
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())

  hostedSessions    Session[]         @relation("SessionHost")
  sessionMembers    SessionMember[]
  connectionsFrom   Connection[]      @relation("ConnectionFrom")
  connectionsTo     Connection[]      @relation("ConnectionTo")
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageReceiver")
  kudosGiven        Kudos[]           @relation("KudosFrom")
  kudosReceived     Kudos[]           @relation("KudosTo")
  groupChatMembers  GroupChatMember[]
  groupChatMessages GroupChatMessage[]
  preferences       UserPreferences?

  emailVerified     Boolean   @default(false)
verificationToken String?
resetToken        String?
resetTokenExpiry  DateTime?

gameParticipants GameParticipant[]
xp               UserXP?
gameNotifications Boolean @default(true)
dailyChallengeAttempts DailyChallengeAttempt[]
dailyTriviaAttempts    DailyTriviaAttempt[]
userAchievements UserAchievement[]
}
model Session {
  id              String   @id @default(cuid())
  courseCode      String
  courseName      String
  date            String
  time            String
  location        String
  roomDetails     String?
  description     String?
  maxParticipants Int      @default(6)
  status          String   @default("open")
  tags            String[]
  createdAt       DateTime @default(now())
  hostAttended    Boolean  @default(false)
  hostNoShowVoteOpen Boolean @default(false)

  host      User            @relation("SessionHost", fields: [hostId], references: [id])
  hostId    String
  members   SessionMember[]
  kudos     Kudos[]
  groupChat GroupChat?
  noShowVotes NoShowVote[]
  duration Int @default(60) // duration in minutes
}

model SessionMember {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())
  attended  Boolean  @default(false)
  checkedInAt DateTime?

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model NoShowVote {
  id        String   @id @default(cuid())
  vote      Boolean
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String

  userId    String
}


model Connection {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  fromUser   User   @relation("ConnectionFrom", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   User   @relation("ConnectionTo", fields: [toUserId], references: [id])
  toUserId String
}

model Message {
  id        String   @id @default(cuid())
  text      String
  read      Boolean  @default(false)
  isRequest Boolean  @default(false)
  accepted  Boolean  @default(false)
  declined  Boolean  @default(false)
  createdAt DateTime @default(now())

  sender     User   @relation("MessageSender", fields: [senderId], references: [id])
  senderId   String

  receiver   User   @relation("MessageReceiver", fields: [receiverId], references: [id])
  receiverId String

  sessionId String?
}

model Kudos {
  id        String   @id @default(cuid())
  tag       String
  createdAt DateTime @default(now())

  fromUser   User   @relation("KudosFrom", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   User   @relation("KudosTo", fields: [toUserId], references: [id])
  toUserId String

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String
}

model GroupChat {
  id        String   @id @default(cuid())
  name      String
  sessionId String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  session  Session           @relation(fields: [sessionId], references: [id])
  members  GroupChatMember[]
  messages GroupChatMessage[]
}

model GroupChatMember {
  id              String    @id @default(cuid())
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  approved        Boolean   @default(true)
  lastRead        DateTime  @default(now())
  rejoinRequested Boolean   @default(false)

  groupChat   GroupChat @relation(fields: [groupChatId], references: [id])
  groupChatId String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model GroupChatMessage {
  id        String   @id @default(cuid())
  text      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  groupChat   GroupChat @relation(fields: [groupChatId], references: [id])
  groupChatId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String
}

model UserPreferences {
  id         String   @id @default(cuid())
  studyStyle String?
  studyTime  String?
  goals      String?
  courses    String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}
model Quote {
  id          String   @id @default(cuid())
  text        String
  author      String
  authorTitle String
  wikiTitle   String
  field       String
  dayTheme    String
  wikiUrl     String
  createdAt   DateTime @default(now())
}
model HBCUFact {
  id        String   @id @default(cuid())
  fact      String
  source    String?
  createdAt DateTime @default(now())
}

model HistoryEvent {
  id           String   @id @default(cuid())
  date         String
  event        String
  year         Int
  significance String?
  createdAt    DateTime @default(now())
}

model GameQuestion {
  id           String   @id @default(cuid())
  question     String
  options      String[]
  correctIndex Int
  type         String   @default("multiple")
  category     String
  difficulty   String   @default("medium")
  createdAt    DateTime @default(now())
  dailyChallenges DailyChallenge[]
}

model GameSession {
  id          String   @id @default(cuid())
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  category    String
  status      String   @default("scheduled")
  gameType    String   @default("live_quiz")
  createdAt   DateTime @default(now())

  participants GameParticipant[]
}

model GameParticipant {
  id          String   @id @default(cuid())
  score       Int      @default(0)
  rank        Int?
  xpEarned    Int      @default(0)
  createdAt   DateTime @default(now())

  gameSession   GameSession @relation(fields: [gameSessionId], references: [id])
  gameSessionId String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model UserXP {
  id           String   @id @default(cuid())
  totalXP      Int      @default(0)
  gamesPlayed  Int      @default(0)
  gamesWon     Int      @default(0)
  winStreak    Int      @default(0)
  bestStreak   Int      @default(0)
  perfectScores Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}
model DailyChallenge {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  questionId  String
  scheduledAt DateTime
  createdAt   DateTime @default(now())

  question    GameQuestion @relation(fields: [questionId], references: [id])
  attempts    DailyChallengeAttempt[]
}

model DailyChallengeAttempt {
  id          String   @id @default(cuid())
  answeredAt  DateTime @default(now())
  answerIndex Int
  isCorrect   Boolean
  timeSeconds Float
  xpEarned    Int      @default(0)

  challenge   DailyChallenge @relation(fields: [challengeId], references: [id])
  challengeId String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model DailyTrivia {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  category  String
  questionIds String[]
  createdAt DateTime @default(now())

  attempts  DailyTriviaAttempt[]
}

model DailyTriviaAttempt {
  id        String   @id @default(cuid())
  answers   Int[]
  score     Int
  timeTaken Int
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  trivia   DailyTrivia @relation(fields: [triviaId], references: [id])
  triviaId String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}
model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "sessions_hosted"
  tier        Int      // 1, 2, or 3
  name        String   // short name e.g. "First Steps"
  description String   // what you need to do
  icon        String   // emoji
  category    String   // Sessions, Messages, Brain Games, etc.
  xpReward    Int      @default(10)
  requirement Int      // the number needed to unlock
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  earnedAt      DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id])
  userId        String

  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId String

  @@unique([userId, achievementId])
}